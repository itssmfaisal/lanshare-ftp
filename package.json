{
  "name": "lanshare-ftp",
  "version": "1.2.0",
  "description": "Beautiful desktop FTP server for sharing files on your local network",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder"
  },
  "author": {
    "name": "S M Faisal",
    "email": "itssmfaisal@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "ftp-srv": "^4.6.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "LanShare FTP",
  "build": {
    "appId": "com.lanshare.ftp",
    "productName": "LanShare FTP",
    "artifactName": "LanShare-FTP-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "S M Faisal <itssmfaisal@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "LanShare-FTP-${version}-win-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LanShare-FTP-${version}-win-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "publish": null
  },
  "homepage": "https://github.com/itssmfaisal/lanshare-ftp",
  "repository": {
    "type": "git",
    "url": "https://github.com/itssmfaisal/lanshare-ftp.git"
  },
  "desktopName": "lanshare-ftp.desktop"
}
